{
  "name": "@ai-eye/bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Browser bridge script for AI Eye",
  "author": "AI Eye Team",
  "license": "MIT",
  "main": "./dist/aieye-bridge.js",
  "scripts": {
    "build": "esbuild src/aieye-bridge.ts --bundle --outfile=dist/aieye-bridge.js --format=esm --platform=browser --target=es2020 --minify --sourcemap",
    "dev": "pnpm build --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.7.0"
  }
}
