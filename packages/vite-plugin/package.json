{
  "name": "@ai-eye/vite-plugin",
  "version": "1.0.0",
  "description": "Vite plugin for AI Eye source mapping, HMR integration, and browser bridge injection",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "author": "AI Eye Team",
  "license": "MIT",
  "homepage": "https://github.com/SPra03/ai-eye#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SPra03/ai-eye.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/SPra03/ai-eye/issues"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "source-mapping",
    "hmr",
    "jsx",
    "react",
    "vue",
    "svelte",
    "ai-eye",
    "ai",
    "mcp",
    "claude",
    "developer-tools"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "magic-string": "^0.30.5",
    "esbuild": "^0.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.7.0",
    "vite": "^5.0.12"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
