{
  "name": "aieye",
  "version": "1.2.0",
  "description": "MCP server that gives AI agents visual access to web applications — screenshot, inspect, click, type, visual diff, and more",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "aieye": "./dist/index.js"
  },
  "author": "VisionCraft Team",
  "license": "MIT",
  "homepage": "https://github.com/SPra03/ai-eye#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SPra03/ai-eye.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/SPra03/ai-eye/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai",
    "browser-automation",
    "playwright",
    "cdp",
    "visioncraft",
    "source-mapping",
    "developer-tools"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=node --target=node18 --format=esm --sourcemap --banner:js=\"#!/usr/bin/env node\" --external:playwright-core --external:pixelmatch --external:pngjs --minify",
    "dev": "pnpm build --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "pixelmatch": "^6.0.0",
    "playwright-core": "^1.41.0",
    "pngjs": "^7.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.7.0",
    "@types/pngjs": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
