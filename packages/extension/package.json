{
  "name": "ai-eye-extension",
  "displayName": "AI Eye",
  "description": "AI-native visual development for VS Code",
  "version": "1.0.0",
  "publisher": "aieye",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SPra03/ai-eye.git",
    "directory": "packages/extension"
  },
  "homepage": "https://github.com/SPra03/ai-eye#readme",
  "bugs": {
    "url": "https://github.com/SPra03/ai-eye/issues"
  },
  "keywords": [
    "ai-eye",
    "ai",
    "visual",
    "preview",
    "mcp",
    "source-mapping"
  ],
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Debuggers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:aieye.openPreview",
    "onCommand:aieye.testScreenshot",
    "onCommand:aieye.runV2Tests"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aieye.openPreview",
        "title": "AI Eye: Open Live Preview"
      },
      {
        "command": "aieye.startServer",
        "title": "AI Eye: Start MCP Server"
      },
      {
        "command": "aieye.reloadPreview",
        "title": "AI Eye: Reload Preview"
      },
      {
        "command": "aieye.toggleCDP",
        "title": "AI Eye: Toggle CDP Mode"
      },
      {
        "command": "aieye.testScreenshot",
        "title": "AI Eye: Test Screenshot (v2)"
      },
      {
        "command": "aieye.runV2Tests",
        "title": "AI Eye: Run V2 Comprehensive Tests"
      }
    ],
    "configuration": {
      "title": "AI Eye",
      "properties": {
        "aieye.devServerUrl": {
          "type": "string",
          "default": "http://localhost:5175",
          "description": "URL of the running dev server"
        },
        "aieye.framework": {
          "type": "string",
          "enum": [
            "auto",
            "react",
            "vue",
            "svelte",
            "html"
          ],
          "default": "auto",
          "description": "Framework detection mode"
        },
        "aieye.screenshotQuality": {
          "type": "number",
          "default": 80,
          "minimum": 30,
          "maximum": 100,
          "description": "JPEG quality for screenshots (30-100)"
        },
        "aieye.enableCDP": {
          "type": "boolean",
          "default": false,
          "description": "Enable CDP fallback for advanced features"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "aieye",
        "label": "AI Eye Live Preview Tools",
        "description": "AI-native visual development tools for inspecting, interacting with, and debugging web UIs directly in VS Code"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:playwright-core --format=cjs --platform=node --target=node18 --sourcemap",
    "dev": "pnpm build --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "vsce:publish": "vsce publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@ai-eye/bridge": "workspace:*",
    "aieye": "workspace:*",
    "playwright-core": "^1.41.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.20.0",
    "typescript": "^5.7.0"
  }
}
