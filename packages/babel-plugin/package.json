{
  "name": "@ai-eye/babel-plugin",
  "version": "1.0.0",
  "description": "Babel plugin for AI Eye source mapping - automatically injects source location attributes into JSX elements",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "author": "AI Eye Team",
  "license": "MIT",
  "homepage": "https://github.com/SPra03/ai-eye#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SPra03/ai-eye.git",
    "directory": "packages/babel-plugin"
  },
  "bugs": {
    "url": "https://github.com/SPra03/ai-eye/issues"
  },
  "keywords": [
    "babel",
    "babel-plugin",
    "source-mapping",
    "jsx",
    "react",
    "ai-eye",
    "ai",
    "mcp",
    "claude",
    "developer-tools"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@babel/core": "^7.23.7",
    "@babel/types": "^7.23.6"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.20.5",
    "@types/node": "^20.11.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
