{
  "mcpServers": {
    "aieye": {
      "command": "node",
      "args": ["packages/mcp-server/dist/index.js"],
      "env": {
        "AIEYE_WEBVIEW_ENABLED": "true",
        "AIEYE_BRIDGE_URL": "http://localhost:18420",
        "AIEYE_URL": "http://localhost:5175"
      }
    },
    "aieye-playwright": {
      "command": "node",
      "args": ["packages/mcp-server/dist/index.js"],
      "env": {
        "AIEYE_URL": "http://localhost:5175"
      }
    },
    "macos": {
      "command": "node",
      "args": ["packages/macos-mcp-server/dist/index.js"]
    }
  }
}
